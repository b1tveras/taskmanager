# Database (MySQL)
DB_URL=jdbc:mysql://localhost:3306/taskmanager?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=yourpassword

# JWT - generate a strong Base64-encoded secret (min 32 chars)
# Generate: openssl rand -base64 32
JWT_SECRET=c2VjcmV0a2V5Zm9ydGVhbXRhc2ttYW5hZ2VyYXBwbGljYXRpb24yMDI0
JWT_EXPIRATION=86400000

# CORS - comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
